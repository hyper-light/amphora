hash-threshold 8

# written for rule.collation:ORDER BY uses COLLATE, then the column's: the shared tables, the group's own setup, then its cases

statement ok
CREATE TABLE t1(a INTEGER, b TEXT, c REAL, d BLOB, e)

statement ok
INSERT INTO t1 VALUES (1, 'one', 1.5, x'01', 1), (2, 'two', 2.5, x'02', 'two'), (3, 'three', NULL, NULL, 3.5), (4, NULL, 4.5, x'0405', NULL), (5, 'Five', -5.5, x'', 'x'), (6, '', 0.0, x'ff', 6), (NULL, 'null-a', 7.25, x'07', x'07')

statement ok
CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

statement ok
CREATE TABLE r(b TEXT, n TEXT COLLATE NOCASE, t TEXT COLLATE RTRIM)

statement ok
INSERT INTO r VALUES ('a', 'a', 'a '), ('B', 'B', 'B'), ('a ', 'A', 'a')

query T nosort
SELECT n FROM r ORDER BY n, b
----
a
A
B

query T nosort
SELECT n FROM r ORDER BY n COLLATE BINARY
----
A
B
a

query T nosort
SELECT b FROM r ORDER BY b COLLATE NOCASE, b
----
a
a 
B

query T nosort
SELECT t FROM r ORDER BY t, b
----
B
a 
a

query T nosort
SELECT b FROM r ORDER BY b
----
B
a
a 

query T nosort
SELECT n FROM r ORDER BY n DESC, b
----
B
a
A

query T nosort
SELECT b FROM r ORDER BY b COLLATE RTRIM, b
----
B
a
a 

query T nosort
SELECT n || '' FROM r ORDER BY 1
----
A
B
a

query T nosort
SELECT n FROM r ORDER BY n COLLATE RTRIM, b
----
A
B
a

query T nosort
SELECT upper(n) FROM r ORDER BY n, 1
----
A
A
B
