CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

statement ok
CREATE TABLE r(b TEXT, n TEXT COLLATE NOCASE, t TEXT COLLATE RTRIM)

statement ok
INSERT INTO r VALUES ('a', 'a', 'a '), ('B', 'B', 'B'), ('a ', 'A', 'a')

query I rowsort
SELECT b = 'A' FROM r
----
0
0
0

query I rowsort
SELECT count(*) FROM r WHERE b = 'a'
----
1

query I rowsort
SELECT count(*) FROM r WHERE b < 'b'
----
3

query T nosort
SELECT b FROM r ORDER BY b
----
B
a
a 

query I rowsort
SELECT count(DISTINCT b) FROM r
----
3

query T rowsort
SELECT min(b) FROM r
----
B

query I rowsort
SELECT b IN ('A', 'B') FROM r
----
0
0
1

query I rowsort
SELECT b BETWEEN 'A' AND 'Z' FROM r
----
0
0
1

query I rowsort
SELECT b > 'a' FROM r
----
0
0
1

query T nosort
SELECT b FROM r GROUP BY b ORDER BY 1
----
B
a
a 
