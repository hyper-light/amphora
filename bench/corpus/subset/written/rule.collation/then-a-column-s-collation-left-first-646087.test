CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

statement ok
CREATE TABLE r(b TEXT, n TEXT COLLATE NOCASE, t TEXT COLLATE RTRIM)

statement ok
INSERT INTO r VALUES ('a', 'a', 'a '), ('B', 'B', 'B'), ('a ', 'A', 'a')

query I rowsort
SELECT n = b FROM r
