hash-threshold 8

# written for function.aggregate:group_concat: the shared tables, the group's own setup, then its cases

statement ok
CREATE TABLE t1(a INTEGER, b TEXT, c REAL, d BLOB, e)

statement ok
INSERT INTO t1 VALUES (1, 'one', 1.5, x'01', 1), (2, 'two', 2.5, x'02', 'two'), (3, 'three', NULL, NULL, 3.5), (4, NULL, 4.5, x'0405', NULL), (5, 'Five', -5.5, x'', 'x'), (6, '', 0.0, x'ff', 6), (NULL, 'null-a', 7.25, x'07', x'07')

statement ok
CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

query T rowsort
SELECT group_concat(a, '|') FROM t1
----
1|2|3|4|5|6

query T rowsort
SELECT group_concat(b, '|') FROM t1
----
one|two|three|Five||null-a

query T rowsort
SELECT group_concat(c, '|') FROM t1
----
1.5|2.5|4.5|-5.5|0.0|7.25

query T rowsort
SELECT group_concat(e, '|') FROM t1
----
1|two|3.5|x|6|@

query T rowsort
SELECT group_concat(DISTINCT a) FROM t1
----
1,2,3,4,5,6

query T rowsort
SELECT group_concat(a * 2, '|') FROM t1
----
2|4|6|8|10|12

query T rowsort
SELECT group_concat(length(b), '|') FROM t1
----
3|3|5|4|0|6

query T rowsort
SELECT group_concat(c + a, '|') FROM t1
----
2.5|4.5|8.5|-0.5|6.0

query T rowsort
SELECT group_concat(CASE WHEN a > 2 THEN a END, '|') FROM t1
----
3|4|5|6

query T rowsort
SELECT group_concat(coalesce(c, 0), '|') FROM t1
----
1.5|2.5|0|4.5|-5.5|0.0|7.25

query IT nosort
SELECT a % 2, group_concat(a, '|') FROM t1 GROUP BY 1 ORDER BY 1
----
NULL
NULL
0
2|4|6
1
1|3|5
