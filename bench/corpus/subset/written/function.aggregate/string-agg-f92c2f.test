hash-threshold 8

# written for function.aggregate:string_agg: the shared tables, the group's own setup, then its cases

statement ok
CREATE TABLE t1(a INTEGER, b TEXT, c REAL, d BLOB, e)

statement ok
INSERT INTO t1 VALUES (1, 'one', 1.5, x'01', 1), (2, 'two', 2.5, x'02', 'two'), (3, 'three', NULL, NULL, 3.5), (4, NULL, 4.5, x'0405', NULL), (5, 'Five', -5.5, x'', 'x'), (6, '', 0.0, x'ff', 6), (NULL, 'null-a', 7.25, x'07', x'07')

statement ok
CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

query T rowsort
SELECT string_agg(CAST(a AS TEXT), ',') FROM t1
----
1,2,3,4,5,6

query T rowsort
SELECT string_agg(CAST(b AS TEXT), ',') FROM t1
----
one,two,three,Five,,null-a

query T rowsort
SELECT string_agg(CAST(c AS TEXT), ',') FROM t1
----
1.5,2.5,4.5,-5.5,0.0,7.25

query T rowsort
SELECT string_agg(CAST(e AS TEXT), ',') FROM t1
----
1,two,3.5,x,6,@

query T rowsort
SELECT string_agg(CAST(a AS TEXT), ',') FROM t1
----
1,2,3,4,5,6

query T rowsort
SELECT string_agg(CAST(a * 2 AS TEXT), ',') FROM t1
----
2,4,6,8,10,12

query T rowsort
SELECT string_agg(CAST(length(b) AS TEXT), ',') FROM t1
----
3,3,5,4,0,6

query T rowsort
SELECT string_agg(CAST(c + a AS TEXT), ',') FROM t1
----
2.5,4.5,8.5,-0.5,6.0

query T rowsort
SELECT string_agg(CAST(CASE WHEN a > 2 THEN a END AS TEXT), ',') FROM t1
----
3,4,5,6

query T rowsort
SELECT string_agg(CAST(coalesce(c, 0) AS TEXT), ',') FROM t1
----
1.5,2.5,0,4.5,-5.5,0.0,7.25
