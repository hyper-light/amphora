hash-threshold 8

# written for keyword:HAVING: the shared tables, the group's own setup, then its cases

statement ok
CREATE TABLE t1(a INTEGER, b TEXT, c REAL, d BLOB, e)

statement ok
INSERT INTO t1 VALUES (1, 'one', 1.5, x'01', 1), (2, 'two', 2.5, x'02', 'two'), (3, 'three', NULL, NULL, 3.5), (4, NULL, 4.5, x'0405', NULL), (5, 'Five', -5.5, x'', 'x'), (6, '', 0.0, x'ff', 6), (NULL, 'null-a', 7.25, x'07', x'07')

statement ok
CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

query II nosort
SELECT a % 2, count(*) FROM t1 GROUP BY 1 HAVING count(*) > 2 ORDER BY 1
----
0
3
1
3

query TI rowsort
SELECT b, count(*) FROM t2 GROUP BY b HAVING count(*) > 1
----
Y
2
x
2

query II nosort
SELECT c, sum(a) FROM t2 GROUP BY c HAVING sum(a) > 3 ORDER BY 1
----
NULL
6
20
5
70
7

query I nosort
SELECT a % 3 AS g FROM t1 GROUP BY g HAVING g IS NOT NULL ORDER BY g
----
0
1
2

query I rowsort
SELECT count(*) FROM t1 HAVING count(*) > 0
----
7

query T rowsort
SELECT count(*) FROM t1 HAVING count(*) > 100
----

query I nosort
SELECT a FROM t1 GROUP BY a HAVING max(c) > 2 ORDER BY a
----
NULL
2
4

query TR nosort
SELECT b, avg(c) FROM t1 GROUP BY b HAVING avg(c) BETWEEN 0 AND 5 ORDER BY b
----
NULL
4.500
(empty)
0.000
one
1.500
two
2.500

query IT rowsort
SELECT a % 2, max(b) FROM t1 GROUP BY 1 HAVING max(b) LIKE 't%'
----
0
two
1
three

query I nosort
SELECT a FROM t1 GROUP BY a HAVING a IN (SELECT a FROM t2) ORDER BY 1
----
1
2
3
6

statement error
SELECT a FROM t1 HAVING a > 1

query T rowsort
SELECT b FROM t2 GROUP BY b HAVING sum(c) IS NULL
