hash-threshold 8

# written for keyword:CROSS: the shared tables, the group's own setup, then its cases

statement ok
CREATE TABLE t1(a INTEGER, b TEXT, c REAL, d BLOB, e)

statement ok
INSERT INTO t1 VALUES (1, 'one', 1.5, x'01', 1), (2, 'two', 2.5, x'02', 'two'), (3, 'three', NULL, NULL, 3.5), (4, NULL, 4.5, x'0405', NULL), (5, 'Five', -5.5, x'', 'x'), (6, '', 0.0, x'ff', 6), (NULL, 'null-a', 7.25, x'07', x'07')

statement ok
CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

query I rowsort
SELECT count(*) FROM t1 CROSS JOIN t2
----
35

query II nosort
SELECT t1.a, t2.a FROM t1 CROSS JOIN t2 WHERE t1.a = t2.a ORDER BY 1
----
1
1
2
2
3
3
6
6

query I rowsort
SELECT count(*) FROM t1 AS x CROSS JOIN t1 AS y
----
49

query I nosort
SELECT x.a FROM t2 AS x CROSS JOIN t2 AS y WHERE x.a = y.c / 10 ORDER BY 1
----
1
2
2
7

query I rowsort
SELECT count(*) FROM t1 CROSS JOIN t2 CROSS JOIN t1 AS t3
----
245

query I rowsort
SELECT min(t1.a + t2.a) FROM t1 CROSS JOIN t2
----
2

query I rowsort
SELECT count(*) FROM (SELECT 1) CROSS JOIN t2
