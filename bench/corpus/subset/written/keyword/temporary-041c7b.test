hash-threshold 8

# written for keyword:TEMPORARY: the shared tables, the group's own setup, then its cases

statement ok
CREATE TABLE t1(a INTEGER, b TEXT, c REAL, d BLOB, e)

statement ok
INSERT INTO t1 VALUES (1, 'one', 1.5, x'01', 1), (2, 'two', 2.5, x'02', 'two'), (3, 'three', NULL, NULL, 3.5), (4, NULL, 4.5, x'0405', NULL), (5, 'Five', -5.5, x'', 'x'), (6, '', 0.0, x'ff', 6), (NULL, 'null-a', 7.25, x'07', x'07')

statement ok
CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

statement ok
CREATE TEMPORARY TABLE kt(a)

statement ok
INSERT INTO kt VALUES (1)

query I rowsort
SELECT a FROM temp.kt
----
1

statement ok
CREATE TEMPORARY VIEW kv AS SELECT a FROM kt

query I rowsort
SELECT a FROM kv
----
1

statement ok
CREATE TEMPORARY TRIGGER ktr AFTER INSERT ON kt BEGIN SELECT 1; END

statement ok
CREATE TEMPORARY TABLE IF NOT EXISTS kt(b)

statement ok
CREATE TEMPORARY TABLE kt2 AS SELECT a * 2 AS d FROM kt

query I rowsort
SELECT d FROM kt2
----
2

query T nosort
SELECT name FROM sqlite_temp_schema ORDER BY name
----
kt
kt2
ktr
kv

