hash-threshold 8

# written for keyword:MATERIALIZED: the shared tables, the group's own setup, then its cases

statement ok
CREATE TABLE t1(a INTEGER, b TEXT, c REAL, d BLOB, e)

statement ok
INSERT INTO t1 VALUES (1, 'one', 1.5, x'01', 1), (2, 'two', 2.5, x'02', 'two'), (3, 'three', NULL, NULL, 3.5), (4, NULL, 4.5, x'0405', NULL), (5, 'Five', -5.5, x'', 'x'), (6, '', 0.0, x'ff', 6), (NULL, 'null-a', 7.25, x'07', x'07')

statement ok
CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

query I rowsort
WITH x AS MATERIALIZED (SELECT a FROM t1) SELECT count(*) FROM x
----
7

query I rowsort
WITH x AS NOT MATERIALIZED (SELECT a FROM t1) SELECT count(*) FROM x
----
7

query I rowsort
WITH x AS MATERIALIZED (SELECT a FROM t1 WHERE a > 2), y AS NOT MATERIALIZED (SELECT a FROM x) SELECT sum(a) FROM y
----
18

query I rowsort
WITH x(v) AS MATERIALIZED (VALUES (1), (2)) SELECT max(v) FROM x
----
2

query I rowsort
WITH x AS MATERIALIZED (SELECT random() AS r) SELECT a.r = b.r FROM x AS a, x AS b
----
1

query I rowsort
WITH RECURSIVE c(n) AS MATERIALIZED (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 4) SELECT sum(n) FROM c
----
10

query T rowsort
WITH x AS NOT MATERIALIZED (SELECT a, b FROM t2) SELECT b FROM x WHERE a = 2
----
Y

query T nosort
WITH x AS MATERIALIZED (SELECT a FROM t1) SELECT t2.b FROM t2 JOIN x USING (a) ORDER BY 1
----
x
Y
y
z

statement ok
WITH x AS MATERIALIZED (SELECT a FROM t1) INSERT INTO t2(a, b) SELECT a + 1000, 'm' FROM x WHERE a IS NOT NULL

query I rowsort
SELECT count(*) FROM t2 WHERE a > 1000
----
6

statement error
WITH x AS MATERIALIZED SELECT 1 SELECT * FROM x
