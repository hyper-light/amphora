statement ok
CREATE TABLE kfr(a)

statement ok
CREATE TABLE kfl(n)

statement ok
CREATE TRIGGER kfr1 AFTER INSERT ON kfr FOR EACH ROW BEGIN INSERT INTO kfl VALUES (NEW.a); END

statement ok
CREATE TRIGGER kfr2 BEFORE DELETE ON kfr FOR EACH ROW WHEN OLD.a > 1 BEGIN INSERT INTO kfl VALUES (-OLD.a); END

statement ok
INSERT INTO kfr VALUES (1), (2), (3)

statement ok
