statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

query I rowsort
SELECT 1 -- trailing comment
----
1

query I rowsort
SELECT /* inline */ 2
----
2

query I rowsort
/* leading */ SELECT 3
----
3

query I rowsort
SELECT 4 /* to the end
----
4

query I rowsort
-- a line
SELECT 5
----
5

query I rowsort
SELECT 6 /* a */ + /* b */ 1
----
7

query TT rowsort
SELECT '-- not a comment', '/* nor this */'
----
-- not a comment
/* nor this */

query I rowsort
SELECT 7 --
----
7

query I rowsort
SELECT/**/8
----
8

query I rowsort
SELECT 9 /* multi
line */ + 1
----
10

query I rowsort
SELECT a FROM t1 -- the rows
WHERE a = 2
----
2

query I rowsort
SELECT 10 /* nested /* no */
----
10

query I rowsort
SELECT 11 /* a */ /* b */
----
11
