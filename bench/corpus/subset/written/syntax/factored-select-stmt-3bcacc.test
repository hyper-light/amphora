hash-threshold 8

# written for syntax:factored-select-stmt: the shared tables, the group's own setup, then its cases

statement ok
CREATE TABLE t1(a INTEGER, b TEXT, c REAL, d BLOB, e)

statement ok
INSERT INTO t1 VALUES (1, 'one', 1.5, x'01', 1), (2, 'two', 2.5, x'02', 'two'), (3, 'three', NULL, NULL, 3.5), (4, NULL, 4.5, x'0405', NULL), (5, 'Five', -5.5, x'', 'x'), (6, '', 0.0, x'ff', 6), (NULL, 'null-a', 7.25, x'07', x'07')

statement ok
CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

query I nosort
WITH x AS (SELECT a FROM t1) SELECT a FROM x UNION SELECT a FROM t2 ORDER BY 1 LIMIT 3
----
NULL
1
2

query I nosort
WITH x AS (SELECT 1 AS v) SELECT v FROM x ORDER BY v LIMIT 1 OFFSET 0
----
1

query I nosort
WITH RECURSIVE r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r WHERE n < 3) SELECT n FROM r UNION ALL SELECT n * 10 FROM r ORDER BY 1
----
1
2
3
10
20
30

query II rowsort
WITH a AS (SELECT 1), b AS (SELECT 2) SELECT * FROM a, b
----
1
2

query TI nosort
WITH x AS (SELECT a, b FROM t2) SELECT b, count(*) FROM x GROUP BY b ORDER BY b
----
x
2
Y
2
z
1

query I nosort
WITH x AS (SELECT a FROM t1) SELECT a FROM x ORDER BY a DESC LIMIT 2
----
6
5

query I rowsort
WITH x AS (SELECT a FROM t1) SELECT a FROM x INTERSECT SELECT a FROM t2
----
1
2
3
6

query I nosort
WITH x AS (SELECT a FROM t1) SELECT * FROM (SELECT a FROM x WHERE a > 4) ORDER BY 1
----
5
6

query T rowsort
WITH x AS (SELECT 2 AS a) SELECT t1.b FROM t1, x WHERE t1.a = x.a
----
two

query I rowsort
WITH x AS (SELECT a FROM t1) VALUES ((SELECT count(*) FROM x))
----
7

query I rowsort
WITH x AS (SELECT a FROM t1 ORDER BY a LIMIT 2) SELECT sum(a) FROM x
----
1

query I nosort
WITH x AS (SELECT a FROM t1) SELECT a FROM x ORDER BY a LIMIT 2, 3
----
2
3
4
