statement ok
CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

statement ok
CREATE INDEX ix1 ON t1(a ASC)

statement ok
CREATE INDEX ix2 ON t1(b DESC, a ASC)

statement ok
CREATE INDEX ix3 ON t1(b COLLATE NOCASE)

statement ok
CREATE INDEX ix4 ON t1(b COLLATE RTRIM DESC)

statement ok
CREATE INDEX ix5 ON t1(a * 2)

statement ok
CREATE INDEX ix6 ON t1(substr(b, 1, 1) COLLATE NOCASE)

statement ok
CREATE UNIQUE INDEX ix7 ON t2(b COLLATE BINARY)

