hash-threshold 8

# written for syntax:filter-clause: the shared tables, the group's own setup, then its cases

statement ok
CREATE TABLE t1(a INTEGER, b TEXT, c REAL, d BLOB, e)

statement ok
INSERT INTO t1 VALUES (1, 'one', 1.5, x'01', 1), (2, 'two', 2.5, x'02', 'two'), (3, 'three', NULL, NULL, 3.5), (4, NULL, 4.5, x'0405', NULL), (5, 'Five', -5.5, x'', 'x'), (6, '', 0.0, x'ff', 6), (NULL, 'null-a', 7.25, x'07', x'07')

statement ok
CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

query I rowsort
SELECT count(*) FILTER (WHERE a > 2) FROM t1
----
4

query R rowsort
SELECT sum(c) FILTER (WHERE c > 0) FROM t1
----
15.750

query II nosort
SELECT a % 2, count(*) FILTER (WHERE b IS NOT NULL) FROM t1 GROUP BY 1 ORDER BY 1
----
NULL
1
0
2
1
3

query T rowsort
SELECT group_concat(b, ',') FILTER (WHERE length(b) > 3) FROM t1
----
three,Five,null-a

query RR rowsort
SELECT avg(a) FILTER (WHERE a <> 3), avg(a) FROM t1
----
3.600
3.500

query R rowsort
SELECT max(c) FILTER (WHERE a < 3) FROM t1
----
2.500

query II nosort
SELECT a, sum(a) FILTER (WHERE a % 2 = 1) OVER (ORDER BY a) FROM t1 ORDER BY a
----
14 values hashing to 5e5a8df46be6e5c16bbf0f37b5d85bd8

query I rowsort
SELECT count(*) FILTER (WHERE 0) FROM t1
----
0

query R rowsort
SELECT total(c) FILTER (WHERE b LIKE 't%') FROM t1
----
2.500

query I rowsort
SELECT count(DISTINCT a % 3) FILTER (WHERE a > 1) FROM t1
----
3

statement error
SELECT abs(a) FILTER (WHERE a > 1) FROM t1

query T rowsort
SELECT json_group_array(a) FILTER (WHERE a IS NOT NULL) FROM (SELECT a FROM t1 ORDER BY a)
----
[1,2,3,4,5,6]
