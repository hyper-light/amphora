hash-threshold 8

# written for syntax:raise-function: the shared tables, the group's own setup, then its cases

statement ok
CREATE TABLE t1(a INTEGER, b TEXT, c REAL, d BLOB, e)

statement ok
INSERT INTO t1 VALUES (1, 'one', 1.5, x'01', 1), (2, 'two', 2.5, x'02', 'two'), (3, 'three', NULL, NULL, 3.5), (4, NULL, 4.5, x'0405', NULL), (5, 'Five', -5.5, x'', 'x'), (6, '', 0.0, x'ff', 6), (NULL, 'null-a', 7.25, x'07', x'07')

statement ok
CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

statement ok
CREATE TABLE rf(a)

statement ok
CREATE TRIGGER rf1 BEFORE INSERT ON rf WHEN NEW.a < 0 BEGIN SELECT RAISE(ABORT, 'negative'); END

statement ok
CREATE TRIGGER rf2 BEFORE UPDATE ON rf BEGIN SELECT RAISE(IGNORE) WHERE NEW.a = 0; END

statement ok
CREATE TRIGGER rf3 BEFORE DELETE ON rf WHEN OLD.a = 7 BEGIN SELECT RAISE(FAIL, 'keep seven'); END

statement error
INSERT INTO rf VALUES (-1)

statement ok
INSERT INTO rf VALUES (7), (8)

statement ok
UPDATE rf SET a = 0

query I nosort
SELECT a FROM rf ORDER BY a
----
7
8

statement error
DELETE FROM rf

query I nosort
SELECT a FROM rf ORDER BY a
----
7
8

