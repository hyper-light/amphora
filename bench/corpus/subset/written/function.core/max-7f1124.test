query T rowsort
SELECT max(NULL, 0)
----
NULL

query I rowsort
SELECT max(0, 1)
----
1

query I rowsort
SELECT max(1, -7)
----
1

query R rowsort
SELECT max(-7, 2.5)
----
2.500

query R rowsort
SELECT max(2.5, -0.25)
----
2.500

query T rowsort
SELECT max(-0.25, 'abc')
----
abc

query T rowsort
SELECT max('abc', 'ABC')
----
abc

query T rowsort
SELECT max('ABC', '')
----
ABC

query T rowsort
SELECT max('', '12')
----
12

query T rowsort
SELECT max('12', '3.5x')
----
3.5x
