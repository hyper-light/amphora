query I nosort
SELECT count(*) AS n FROM (SELECT x'00' AS x UNION ALL SELECT 'b' UNION ALL SELECT 2 UNION ALL SELECT NULL UNION ALL SELECT 1.5 UNION ALL SELECT 'A' UNION ALL SELECT 2.0 UNION ALL SELECT '2') GROUP BY x ORDER BY n, min(typeof(x))
----
1
1
1
1
1
1
2

query I rowsort
SELECT count(DISTINCT x) FROM (SELECT x'00' AS x UNION ALL SELECT 'b' UNION ALL SELECT 2 UNION ALL SELECT NULL UNION ALL SELECT 1.5 UNION ALL SELECT 'A' UNION ALL SELECT 2.0 UNION ALL SELECT '2')
----
6

query I rowsort
SELECT count(*) FROM (SELECT 1 AS x UNION ALL SELECT 1.0 UNION ALL SELECT '1') GROUP BY x
----
1
2

query I rowsort
SELECT count(*) FROM (SELECT DISTINCT x FROM (SELECT 1 AS x UNION ALL SELECT '1'))
----
2

query TI rowsort
SELECT typeof(x), count(*) FROM (SELECT 2 AS x UNION ALL SELECT 2.0) GROUP BY x
----
integer
2

query I rowsort
SELECT count(*) FROM (SELECT x'31' AS x UNION ALL SELECT '1') GROUP BY x
----
1
1

query I rowsort
SELECT count(*) FROM (SELECT NULL AS x UNION ALL SELECT NULL) GROUP BY x
----
2

query I rowsort
SELECT count(*) FROM (SELECT 'a' AS x UNION ALL SELECT 'A') GROUP BY x
----
1
1

query I rowsort
SELECT count(*) FROM (SELECT 'a' AS x UNION ALL SELECT 'A') GROUP BY x COLLATE NOCASE
----
2

query I rowsort
SELECT count(*) FROM (SELECT 1e0 AS x UNION ALL SELECT 1) GROUP BY x
----
2
