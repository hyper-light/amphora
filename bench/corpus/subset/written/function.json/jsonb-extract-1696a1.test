query T rowsort
SELECT json(jsonb_extract('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$'))
----
{"a":1,"b":[1,2,{"c":3}],"d":null}

query T rowsort
SELECT json(jsonb_extract('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$.a'))
----
1

query T rowsort
SELECT json(jsonb_extract('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$.b'))
----
[1,2,{"c":3}]

query T rowsort
SELECT json(jsonb_extract('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$.b[0]'))
----
1

query T rowsort
SELECT json(jsonb_extract('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$.b[#-1]'))
----
{"c":3}

