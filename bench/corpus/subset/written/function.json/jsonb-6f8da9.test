query T rowsort
SELECT json(jsonb('{"a":1,"b":[1,2,{"c":3}],"d":null}'))
----
{"a":1,"b":[1,2,{"c":3}],"d":null}

query T rowsort
SELECT json(jsonb('[1,2,3]'))
----
[1,2,3]

query T rowsort
SELECT json(jsonb('{"x":{"y":{"z":true}}}'))
----
{"x":{"y":{"z":true}}}

query T rowsort
SELECT json(jsonb('[]'))
----
[]

query T rowsort
SELECT json(jsonb('{}'))
----
{}

