hash-threshold 8

# written for function.json:json_replace: the shared tables, the group's own setup, then its cases

statement ok
CREATE TABLE t1(a INTEGER, b TEXT, c REAL, d BLOB, e)

statement ok
INSERT INTO t1 VALUES (1, 'one', 1.5, x'01', 1), (2, 'two', 2.5, x'02', 'two'), (3, 'three', NULL, NULL, 3.5), (4, NULL, 4.5, x'0405', NULL), (5, 'Five', -5.5, x'', 'x'), (6, '', 0.0, x'ff', 6), (NULL, 'null-a', 7.25, x'07', x'07')

statement ok
CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

query T rowsort
SELECT json_replace('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$', 9)
----
9

query T rowsort
SELECT json_replace('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$.a', 'x')
----
{"a":"x","b":[1,2,{"c":3}],"d":null}

query T rowsort
SELECT json_replace('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$.b', NULL)
----
{"a":1,"b":null,"d":null}

query T rowsort
SELECT json_replace('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$.b[0]', json('[1]'))
----
{"a":1,"b":[[1],2,{"c":3}],"d":null}

query T rowsort
SELECT json_replace('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$.b[#-1]', 1.5)
----
{"a":1,"b":[1,2,1.5],"d":null}

query T rowsort
SELECT json_replace('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$.x.y', json('{"q":1}'))
----
{"a":1,"b":[1,2,{"c":3}],"d":null}

query T rowsort
SELECT json_replace('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$.zz', true)
----
{"a":1,"b":[1,2,{"c":3}],"d":null}

query T rowsort
SELECT json_replace('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$[1]', -1)
----
{"a":1,"b":[1,2,{"c":3}],"d":null}

query T rowsort
SELECT json_replace('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$.b[2].c', 's')
----
{"a":1,"b":[1,2,{"c":"s"}],"d":null}

query T rowsort
SELECT json_replace('{"a":1,"b":[1,2,{"c":3}],"d":null}', '$.a[0]', 0)
----
{"a":1,"b":[1,2,{"c":3}],"d":null}

query T rowsort
SELECT json_replace('[1,3]', '$[1]', 2)
----
[1,2]
