hash-threshold 8

# written for function.json:jsonb_group_array: the shared tables, the group's own setup, then its cases

statement ok
CREATE TABLE t1(a INTEGER, b TEXT, c REAL, d BLOB, e)

statement ok
INSERT INTO t1 VALUES (1, 'one', 1.5, x'01', 1), (2, 'two', 2.5, x'02', 'two'), (3, 'three', NULL, NULL, 3.5), (4, NULL, 4.5, x'0405', NULL), (5, 'Five', -5.5, x'', 'x'), (6, '', 0.0, x'ff', 6), (NULL, 'null-a', 7.25, x'07', x'07')

statement ok
CREATE TABLE t2(a INTEGER PRIMARY KEY, b TEXT COLLATE NOCASE, c INTEGER)

statement ok
INSERT INTO t2 VALUES (1, 'x', 10), (2, 'Y', 20), (3, 'y', 20), (6, 'z', NULL), (7, 'X', 70)

query T rowsort
SELECT json(jsonb_group_array(a)) FROM (SELECT * FROM t1 ORDER BY rowid)
----
[1,2,3,4,5,6,null]

query T rowsort
SELECT json(jsonb_group_array(b)) FROM (SELECT * FROM t1 ORDER BY rowid)
----
["one","two","three",null,"Five","","null-a"]

query T rowsort
SELECT json(jsonb_group_array(c)) FROM (SELECT * FROM t1 ORDER BY rowid)
----
[1.5,2.5,null,4.5,-5.5,0.0,7.25]

query T rowsort
SELECT json(jsonb_group_array(e)) FROM (SELECT * FROM t1 ORDER BY rowid)
----
[1,"two",3.5,null,"x",6,""]

query T rowsort
SELECT json(jsonb_group_array(a * 2)) FROM (SELECT * FROM t1 ORDER BY rowid)
----
[2,4,6,8,10,12,null]

query T rowsort
SELECT json(jsonb_group_array(upper(b))) FROM (SELECT * FROM t1 ORDER BY rowid)
----
["ONE","TWO","THREE",null,"FIVE","","NULL-A"]

query T rowsort
SELECT json(jsonb_group_array(a IS NULL)) FROM (SELECT * FROM t1 ORDER BY rowid)
----
[0,0,0,0,0,0,1]

query T rowsort
SELECT json(jsonb_group_array(length(b))) FROM (SELECT * FROM t1 ORDER BY rowid)
----
[3,3,5,null,4,0,6]

query T rowsort
SELECT json(jsonb_group_array(c > 2)) FROM (SELECT * FROM t1 ORDER BY rowid)
----
[0,1,null,1,0,0,1]

query T rowsort
SELECT json(jsonb_group_array(coalesce(b, ''))) FROM (SELECT * FROM t1 ORDER BY rowid)
----
["one","two","three","","Five","","null-a"]
