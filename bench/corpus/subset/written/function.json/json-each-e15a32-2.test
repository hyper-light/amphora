statement ok
CREATE TABLE doc(id INTEGER PRIMARY KEY, body TEXT)

statement ok
INSERT INTO doc VALUES (1, '{"name":"a","tags":["x","y"],"n":1}'), (2, '{"name":"b","tags":[],"n":2.5}'), (3, '{"name":null,"tags":["z"],"nested":{"k":[1,2,3]}}'), (4, 'not json')

query IT nosort
SELECT id, body ->> '$.name' FROM doc WHERE json_valid(body) ORDER BY id
----
1
a
2
b
3
NULL

query IT nosort
SELECT id, body -> '$.tags' FROM doc WHERE json_valid(body) ORDER BY id
----
1
["x","y"]
2
[]
3
["z"]

query II nosort
SELECT id, json_array_length(body, '$.tags') FROM doc WHERE json_valid(body) ORDER BY id
----
1
2
2
0
3
1

query IT nosort
SELECT doc.id, j.value FROM doc, json_each(doc.body, '$.tags') AS j WHERE json_valid(doc.body) ORDER BY doc.id, j.key
----
1
x
1
y
3
z

query I rowsort
SELECT count(*) FROM doc, json_tree(doc.body) WHERE json_valid(doc.body) AND json_tree.type = 'integer'
----
4

query I nosort
SELECT id FROM doc WHERE json_valid(body) AND body ->> '$.n' > 1 ORDER BY id
----
2

query T rowsort
SELECT json_group_array(body ->> '$.name') FROM (SELECT body FROM doc WHERE json_valid(body) ORDER BY id)
----
["a","b",null]

query T rowsort
SELECT json_group_object(id, body -> '$.n') FROM (SELECT id, body FROM doc WHERE json_valid(body) ORDER BY id)
----
{"1":1,"2":2.5,"3":null}

query T rowsort
UPDATE doc SET body = json_set(body, '$.n', 10) WHERE id = 1 RETURNING body
----
{"name":"a","tags":["x","y"],"n":10}

query T rowsort
UPDATE doc SET body = json_insert(body, '$.tags[#]', 'w') WHERE id = 2 RETURNING body
----
{"name":"b","tags":["w"],"n":2.5}

query TI rowsort
SELECT body -> '$.nested.k[1]', body ->> '$.nested.k[#-1]' FROM doc WHERE id = 3
----
2
3

