query T rowsort
SELECT CASE WHEN 1 THEN 'a' ELSE 'b' END
----
a

query T rowsort
SELECT CASE WHEN 0 THEN 'a' ELSE 'b' END
----
b

query T rowsort
SELECT CASE WHEN NULL THEN 'a' END
----
NULL

query T rowsort
SELECT CASE 1 WHEN 1 THEN 'one' WHEN 2 THEN 'two' END
----
one

query T rowsort
SELECT CASE 3 WHEN 1 THEN 'one' ELSE 'other' END
----
other

query T rowsort
SELECT CASE NULL WHEN NULL THEN 'n' ELSE 'not' END
----
not

query I rowsort
SELECT CASE WHEN 2 > 1 THEN 1 WHEN 1 THEN 2 END
----
1

query I rowsort
SELECT CASE 'a' WHEN 'A' THEN 1 ELSE 0 END
----
0

query I rowsort
SELECT CASE WHEN 'x' THEN 1 ELSE 0 END
----
0

query T rowsort
SELECT CASE 2.0 WHEN 2 THEN 'eq' ELSE 'ne' END
----
eq
