> INSERT INTO r(k) WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 1000) SELECT 1000 + i FROM n;

> CREATE INDEX r_k ON r(k);

