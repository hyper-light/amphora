--- WITH f AS NOT MATERIALIZED (SELECT g.k AS k, g.v AS v FROM g WHERE g.v IS NOT NULL) SELECT q.k, count(*) FROM q GROUP BY q.k HAVING q.k IN (SELECT a2.k FROM q AS a2 WHERE EXISTS (WITH g AS MATERIALIZED (SELECT a3.k AS k, a3.v AS v FROM f AS a3 WHERE a3.k = q.k), d AS (SELECT x.k, y.v FROM f AS x LEFT JOIN f AS y ON x.k = y.k) SELECT 1 FROM g AS a4 LEFT JOIN d AS a5 ON a4.k = a5.k WHERE (a5.k >= a5.v OR a2.k IS NOT NULL)))
